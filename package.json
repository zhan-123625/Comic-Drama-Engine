{
  "name": "comic-drama-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "start:server": "tsx server/index.ts",
    "start": "node --import tsx server/index.ts",
    "deploy:build": "vite build --config web/vite.config.ts",
    "deploy:start": "pm2 start ecosystem.config.cjs",
    "deploy:stop": "pm2 stop comic-drama-engine",
    "deploy:restart": "pm2 restart comic-drama-engine",
    "deploy:logs": "pm2 logs comic-drama-engine",
    "lint": "eslint server/ web/src/",
    "lint:fix": "eslint server/ web/src/ --fix",
    "format": "prettier --write \"server/**/*.ts\" \"web/src/**/*.{vue,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:server": "tsc --noEmit",
    "typecheck:web": "vue-tsc --noEmit --project web/tsconfig.json",
    "typecheck": "npm run typecheck:server && npm run typecheck:web"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@alicloud/bailian20231229": "^2.14.5",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.2.0",
    "jimp": "^1.6.1",
    "pinia": "^3.0.4",
    "undici": "^7.16.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.10",
    "concurrently": "^9.1.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.7",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
