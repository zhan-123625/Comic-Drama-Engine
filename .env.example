# ──────────────────────────────────────────────
# Comic Drama Engine 环境变量配置
# 复制本文件为 .env 并根据实际情况修改
# ──────────────────────────────────────────────

# === 必填（生产环境） ===
# 生产环境下必须设置，否则服务会返回 500
API_TOKEN=

# === 服务端口 ===
MY_APP_PORT=3710

# === CORS 允许的来源（逗号分隔） ===
# 开发环境示例：MY_APP_CORS_ORIGIN=http://localhost:5177
# 生产环境设置实际域名，未设置则禁止跨域
# MY_APP_CORS_ORIGIN=http://localhost:5177

# === 公网地址（视频云回调等场景需要） ===
# MY_APP_PUBLIC_URL=https://your-domain.com

# === 请求体限制 ===
MY_APP_BODY_LIMIT=20mb
MY_APP_LONG_TEXT_MAX=5000000
MY_APP_SOURCE_TEXT_MAX=12000000

# === 日志 ===
MY_APP_LOG_LEVEL=info
# json | pretty（开发环境默认 pretty，生产默认 json）
# MY_APP_LOG_FORMAT=json
# 是否写入 data/logs/server.log
# MY_APP_LOG_TO_FILE=1
# HTTP 日志静默前缀（逗号分隔，匹配的路径仅记 debug）
MY_APP_LOG_HTTP_SILENT_PREFIXES=/api/files
# 服务名（日志中标记）
# MY_APP_SERVICE_NAME=comic-drama-engine

# === AI 模型接入与密钥配置安全说明 ===
# 提示：本引擎支持在系统【设置】页面安全配置各大模型服务商 API 密钥与地址
# （如阿里云百炼/通义万相、火山引擎方舟、OpenAI 兼容接口等），配置存储在本地数据库中。
# 敏感 API 密钥与数据库严禁上传公开仓库，请通过环境变量或本地私有配置注入。

# === SSE 长连接 ===
# MY_APP_SSE_HEARTBEAT_MS=30000
# MY_APP_SSE_STALE_MS=120000
# MY_APP_SSE_STALE_CHECK_MS=60000

# === 资产库缓存 ===
# MY_APP_ASSET_LIBRARY_CACHE_TTL_MS=5000

# === LLM 调试 ===
# MY_APP_DEBUG_LLM=1

# === 图片引用模式 ===
# MY_APP_IMAGE_REFERENCE_MODE=
# MY_APP_IMAGE_REFERENCE_FIELD=

# === 运行环境 ===
# NODE_ENV=production
